{
	"name": "gallery-display",
	"version": "1.0.0",
	"description": "A flexible image gallery block for WordPress.",
	"author": "Phil Hoyt",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"build": "WP_COPY_PHP_FILES_TO_DIST=true wp-scripts build",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"lint:php": "vendor/bin/phpcs",
		"lint": "npm run lint:js && npm run lint:css && npm run lint:php",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "WP_COPY_PHP_FILES_TO_DIST=true wp-scripts plugin-zip",
		"start": "WP_COPY_PHP_FILES_TO_DIST=true wp-scripts start"
	},
	"devDependencies": {
		"@wordpress/scripts": "^30.0.0"
	},
	"dependencies": {
		"isotope-layout": "^3.0.6",
		"isotope-packery": "^2.0.1",
		"justified-layout": "^4.1.0",
		"photoswipe": "^5.4.4"
	}
}
