{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ph/gallery-display",
	"version": "1.1.0",
	"title": "Gallery Display",
	"category": "media",
	"icon": "format-gallery",
	"description": "A flexible image gallery with grid, masonry, mosaic, justified, and list layouts.",
	"keywords": [
		"gallery",
		"images",
		"photos",
		"masonry",
		"mosaic",
		"justified"
	],
	"textdomain": "gallery-display",
	"attributes": {
		"images": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object"
			}
		},
		"layout": {
			"type": "string",
			"default": "grid"
		},
		"linkTo": {
			"type": "string",
			"default": "lightbox"
		},
		"thumbnailSize": {
			"type": "string",
			"default": "large"
		},
		"fullSize": {
			"type": "string",
			"default": "full"
		},
		"showCaption": {
			"type": "boolean",
			"default": false
		},
		"captionPosition": {
			"type": "string",
			"default": "below"
		},
		"columns": {
			"type": "number",
			"default": 3
		},
		"aspectRatio": {
			"type": "string",
			"default": "1/1"
		},
		"rowHeight": {
			"type": "number",
			"default": 200
		},
		"orderBy": {
			"type": "string",
			"default": "default"
		},
		"caption": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": true,
		"color": {
			"background": true,
			"text": false
		},
		"spacing": {
			"blockGap": true,
			"__experimentalDefaultControls": {
				"blockGap": true
			}
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true,
			"__experimentalDefaultControls": {
				"color": true,
				"radius": true,
				"style": true,
				"width": true
			}
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
