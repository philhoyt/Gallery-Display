<?xml version="1.0"?>
<ruleset name="Gallery Display">
	<description>PHP coding standards for the Gallery Display plugin.</description>

	<!-- Scan the tree, not a file list, so PHP added later is linted too. -->
	<file>.</file>
	<arg name="extensions" value="php"/>

	<!-- Exclude third-party and generated files -->
	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>node_modules/*</exclude-pattern>
	<exclude-pattern>build/*</exclude-pattern>
	<exclude-pattern>*.asset.php</exclude-pattern>

	<!-- Show progress and use colours -->
	<arg value="sp"/>
	<arg name="colors"/>

	<!-- PHP version compatibility. testVersion is read by PHPCompatibility,
	     which PHPCompatibilityWP layers WordPress's own polyfills onto. -->
	<config name="testVersion" value="7.4-"/>
	<rule ref="PHPCompatibilityWP"/>

	<!-- Standards -->
	<rule ref="WordPress"/>

	<!-- Namespaced plugin — the prefix rule would flag everything. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="PH\GalleryDisplay"/>
				<element value="ph_gallery"/>
				<element value="GALLERY_DISPLAY"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="gallery-display"/>
			</property>
		</properties>
	</rule>
</ruleset>
