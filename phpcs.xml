<?xml version="1.0"?>
<ruleset name="Gallery Display">
	<description>PHP coding standards for the Gallery Display plugin.</description>

	<!-- What to scan -->
	<file>gallery-display.php</file>
	<file>src/render.php</file>

	<!-- Exclude third-party and generated files -->
	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>node_modules/*</exclude-pattern>
	<exclude-pattern>build/*</exclude-pattern>

	<!-- Show progress and use colours -->
	<arg value="sp"/>
	<arg name="colors"/>

	<!-- PHP version compatibility -->
	<config name="testVersion" value="7.4-"/>

	<!-- Standards -->
	<rule ref="WordPress">
		<!-- render.php is a template file included by WordPress; it is not
		     called directly, so the direct-file-access check is redundant
		     (the check at the top of the file handles it). -->
		<exclude name="WordPress.Security.ValidatedSanitizedInput"/>
	</rule>

	<!-- Namespaced plugin — the prefix rule would flag everything. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="PH\GalleryDisplay"/>
				<element value="ph_gallery"/>
				<element value="GALLERY_DISPLAY"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="gallery-display"/>
			</property>
		</properties>
	</rule>
</ruleset>
